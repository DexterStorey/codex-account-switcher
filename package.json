{
  "name": "tokmax",
  "version": "0.5.0",
  "description": "A local account, quota, and runtime control plane for Codex and Claude Code.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tokmax": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run clean && bun build ./src/index.ts --target bun --outdir dist && chmod 755 dist/index.js",
    "check": "bun run typecheck && bun run lint && bun test",
    "clean": "rm -rf dist",
    "dev": "bun run src/index.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prepublishOnly": "bun run check && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "SECURITY.md",
    "COMPATIBILITY.md",
    "LICENSE"
  ],
  "keywords": [
    "codex",
    "cli",
    "auth",
    "accounts",
    "switch",
    "tokens",
    "rate-limits",
    "claude-code"
  ],
  "preferGlobal": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DexterStorey/codex-account-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/DexterStorey/codex-account-switcher/issues"
  },
  "homepage": "https://github.com/DexterStorey/codex-account-switcher#readme",
  "author": "Dexter Storey",
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.2.0",
    "typescript": "^5.8.0"
  }
}
